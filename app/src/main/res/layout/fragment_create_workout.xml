<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.CreateWorkoutFragment"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvChooseType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose a Workout Type"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgWorkoutTypes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:singleSelection="true"
        app:layout_constraintTop_toBottomOf="@+id/tvChooseType"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPush"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Push Day"
            app:chipIcon="@drawable/push" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPull"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pull Day"
            app:chipIcon="@drawable/pull" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLegs"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leg Day"
            app:chipIcon="@drawable/legs" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipUpper"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upper Body"
            app:chipIcon="@drawable/upper" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLower"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lower Body"
            app:chipIcon="@drawable/lower" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCore"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Core"
            app:chipIcon="@drawable/core" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCardio"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cardio"
            app:chipIcon="@drawable/cardio" />

    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilWorkoutName"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/cgWorkoutTypes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:hint="Or enter a custom name (optional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etWorkoutName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnSaveWorkout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Save Workout"
        app:layout_constraintTop_toBottomOf="@+id/tilWorkoutName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>